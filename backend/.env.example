# GameZone PK backend — copy to .env and fill in your own values. NEVER commit .env.
# cp .env.example .env

# Port the server listens on. Render sets PORT automatically; locally 3000 is fine.
PORT=3000

# Admin panel login password (username is always "admin").
# REQUIRED in production: the server refuses to start when NODE_ENV=production and this is unset.
# In development only, an unset value falls back to admin123 (demo only) with a loud warning.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign admin login tokens. Make it long and random, e.g. `openssl rand -hex 32`.
# REQUIRED in production (the server refuses to start without it when NODE_ENV=production).
JWT_SECRET=change-me-to-a-long-random-secret

# Allowed frontend origins for cross-site API calls (comma-separated).
# Leave empty to allow only the GameZone PK site itself and localhost.
# If the frontend is hosted on a different domain than the backend, set it, e.g.:
# CORS_ORIGIN=https://gamezonepk.com
CORS_ORIGIN=

# NODE_ENV=production on Render / live servers.
NODE_ENV=development
